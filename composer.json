{
	"name" : "raincity/php-library",
	"description" : "Library to support implementations in PHP",
	"type" : "library",
	"version" : "2.1.70",
	"license" : "BSD-3-Clause",
	"minimum-stability" : "stable",
	"config" : {
		"allow-plugins" : {
			"composer/installers" : true,
			"phpstan/extension-installer" : true
		}
	},
	"require" : {
		"php" : ">=8.2",
		"composer/installers" : "~2.3",
		"psr/log" : "~3.0",
		"monolog/monolog" : "~3.10",
		"psr/simple-cache" : "~3.0",
		"symfony/cache" : "~7.4",
		"guzzlehttp/guzzle" : "~8.3",
		"json-mapper/json-mapper" : "~2.25"
	},
	"require-dev" : {
		"phpunit/phpunit" : "~11.5",
		"brain/monkey" : "~2.7",
		"phpstan/phpstan" : "~2.1",
		"phpstan/extension-installer" : "~1.4",
		"phpstan/phpstan-deprecation-rules": "^2.0"
	},
	"autoload" : {
		"classmap" : [
			"src/"
		],
		"psr-4" : {
			"RainCity\\" : [
				"src/RainCity",
				"test/RainCity"
			]
		}
	},
	"autoload-dev" : {
		"classmap" : [
			"test/"
		],
		"psr-4" : {
			"RainCity\\" : "test/RainCity"
		}
	}
}
